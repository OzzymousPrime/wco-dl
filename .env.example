# WCO-DL Environment Configuration
# Copy this file to .env and adjust values as needed. Nothing here is required to start: Sonarr's address and key
# and the folder check are on the Settings page in the browser, and what is saved there wins over this file.

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Node environment (development or production)
NODE_ENV=production

# Port for the NestJS server (default: 3000)
SERVER_PORT=3000

# Port for Byparr service (default: 8191)
# Note: This is only for external access. Internal communication uses 8191.
BYPARR_PORT=8191

# ============================================================================
# DOWNLOAD SETTINGS
# ============================================================================

# Base directory for downloaded files
# In Docker: this is a volume mount point
# Outside Docker: use absolute path
OUTPUT_BASE=/data/downloads

# Docker Compose: the folder on this machine where downloads are saved. Use one Sonarr can also see, or imports
# cannot work. Left empty, downloads go to a Docker volume that only this container can reach.
DOWNLOADS_DIR=

# User ID for file permissions (production only)
PUID=1000

# Group ID for file permissions (production only)
PGID=1000

# ============================================================================
# SONARR INTEGRATION (Optional)
# ============================================================================

# These three can be left empty and filled in on the Settings page, which tests them before saving.

# Sonarr URL for automatic library imports after download
SONARR_URL=

# Sonarr API key (get from Sonarr: Settings > General > API Key)
SONARR_API_KEY=

# Where Sonarr sees OUTPUT_BASE, when Sonarr runs outside this container or on another machine
# (for example D:\Downloads\wco-dl). Leave empty when Sonarr sees the same path.
SONARR_IMPORT_BASE=

# Optional: a password for the Settings page. Without one, anyone who can open wco-dl can change its settings.
# It can also be set on the page itself; set here, it cannot be changed there.
ADMIN_PASSWORD=

# ============================================================================
# EPISODE MAP AND OVERNIGHT GAP FILLER (needs Sonarr)
# ============================================================================

# Time zone for the overnight window (set in Settings, default 01:00 to 07:00)
TZ=UTC

# Optional: POST short JSON messages here: the night's summary, new dubs of followed shows, a full disk
# ({"source","title","body","url"}; works with an n8n or Home Assistant webhook)
NOTIFY_URL=
# Optional: sent with that POST as the x-notify-token header
NOTIFY_TOKEN=
# Optional: this app's address as you open it, for the link in that summary
PUBLIC_URL=

# ============================================================================
# CORS SETTINGS
# ============================================================================

# CORS origin (default: http://localhost:3000)
# Set to your domain if accessing from elsewhere
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# BYPARR SETTINGS (Cloudflare Bypass)
# ============================================================================

# Proxy configuration for Byparr (optional)
# Format: protocol://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Browser locale and timezone for Byparr
# Helps avoid detection by matching your region
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=UTC

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Python binary path (default: python)
PYTHON_BIN=python

# Byparr max timeout in milliseconds (default: 60000)
BYPARR_MAX_TIMEOUT_MS=60000

# Download idle timeout in milliseconds (default: 210000)
# If no output for this long, the download is killed
DOWNLOAD_IDLE_TIMEOUT_MS=210000

# Downloads from the Browse page that run at once (default: 3, at most 20). The rest wait their turn.
# Many at once look like an attack to wcostream and Cloudflare, and get the address blocked.
MAX_PARALLEL_DOWNLOADS=3

# Nothing new starts while the drive holding the downloads has less free than this, in GB (default: 20; 0 turns it off).
# Where downloads share a drive with other things (Docker's own disk, say), a full drive stops more than wco-dl.
MIN_FREE_GB=20

# ============================================================================
# WEBHOOKS
# ============================================================================

# Comma-separated webhook URLs to register at startup (optional)
WEBHOOK_URLS=

# Webhooks to loopback, link-local (169.254.x.x) and private LAN addresses are
# blocked. Set to true to allow them, e.g. for a Home Assistant webhook.
WEBHOOK_ALLOW_INTERNAL=false

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Minimal setup (no Sonarr, no proxy):
# NODE_ENV=production
# SERVER_PORT=3000
# OUTPUT_BASE=/data/downloads

# With Sonarr integration:
# NODE_ENV=production
# SERVER_PORT=3000
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=your-api-key-here
# OUTPUT_BASE=/data/downloads

# With proxy:
# NODE_ENV=production
# SERVER_PORT=3000
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass
# OUTPUT_BASE=/data/downloads
